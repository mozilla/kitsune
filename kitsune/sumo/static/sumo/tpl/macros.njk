{% macro lock_icon() -%}
<svg class="kb-lock" width="12" height="12" viewBox="0 0 24 24" role="img" aria-label="{{ _('Private') }}"><rect x="4" y="11" width="16" height="10" rx="2" fill="currentColor"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" fill="none" stroke="currentColor" stroke-width="2.5"></path></svg>
{%- endmacro %}

{% macro search_result(result, icons) %}
<article class="topic-article {{ result.type }}">
  <div class="topic-article--icon-wrap">
    {% if result.type == 'document' %}
      {% set link_name = "search-result.kb-article" %}
    <img class="topic-article--icon" src="{{ icons.reader_mode }}" alt="">
    {% elif result.type == 'question' %}
      {% set link_name = "search-result.support-forum-question-details" %}
    <img class="topic-article--icon" src="{{ icons.blog }}" alt="">
    {% else %}
      {% set link_name = "search-result.other" %}
    {% endif %}
  </div>
  <div class="topic-article--text">
    <h3 class="sumo-card-heading">
      <a class="title" href="{{ result.url }}"
        data-event-name="link_click"
        data-event-parameters='{
          "link_name": "{{ link_name }}"
          {% if result.rank %},
          "search_result_source": "{% if result.type == 'document' %}kb{% else %}aaq{% endif %}",
          "search_result_rank": {{ result.rank }},
          "search_result_evidence_locale": "{{ result.evidence_locale }}",
          "search_result_display_locale": "{{ result.display_locale }}",
          "search_result_locale_fallback": {% if result.locale_fallback %}1{% else %}0{% endif %}
          {% endif %}
        }'>
        {{ result.title }}
      </a>
    </h3>

    {% if result.type == 'question' %}
      <ul class="topic-article--meta-list thread-meta">
        {% if result.is_solved %}
          {# L10n: This is a question status. #}
          <li>{{ _('Solved') }}</li>
        {% endif %}
        <li>
          {% if result.num_answers > 0 %}
            {{ ngettext('1 reply', '%s replies', result.num_answers)|f([result.num_answers]) }}
          {% else %}
            {{ _('No replies') }}
          {% endif %}
        </li>
        <li>
          {{ ngettext('1 person has this problem', '%s people have this problem', result.num_votes)|f([result.num_votes]) }}
        </li>
        {% if result.num_votes_past_week %}
          <li>
            {{ ngettext('1 new this week', '%s new this week', result.num_votes_past_week)|f([result.num_votes_past_week]) }}
          </li>
        {% endif %}
      </ul>
    {% endif %}
    <p>{{ result.search_summary | safe }}</p>
    {% if result.knowledge_bases and result.knowledge_bases.length %}
      <ul class="tag-list">
        {% for entry in result.knowledge_bases %}
          <li>{% if entry.is_private %}{{ lock_icon() }}&nbsp;{% endif %}{{ entry.name }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</article>
{% endmacro %}
