{
  "extends": "stylelint-config-recommended-scss",
  "plugins": [
    "stylelint-order",
    "@stylistic/stylelint-plugin"
  ],
  "defaultSeverity": "warning",
  "rules": {
    "@stylistic/indentation": 2,
    "no-descending-specificity": null,
    "no-empty-source": null,
    "font-family-no-duplicate-names": null,
    "font-family-no-missing-generic-family-keyword": null,
    "order/order": [
      "dollar-variables",
      "custom-properties",
      "declarations"
    ],
    "order/properties-order": [
      "appearance",
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "box-sizing",
      "float",
      "order",
      "flex",
      "flex-direction",
      "flex-flow",
      "justify-content",
      "align-content",
      "align-items",
      "align-self",
      "margin",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left",
      "padding",
      "padding-top",
      "padding-right",
      "padding-bottom",
      "padding-left",
      "width",
      "min-width",
      "max-width",
      "height",
      "min-height",
      "max-height",
      "box-shadow",
      "border",
      "border-top",
      "border-right",
      "border-bottom",
      "border-left",
      "border-color",
      "border-image",
      "border-radius",
      "border-width",
      "background",
      "background-image",
      "background-color",
      "background-position",
      "background-repeat",
      "background-size",
      "background-attachment",
      "mask",
      "mask-image",
      "mask-position",
      "mask-repeat",
      "mask-size",
      "font",
      "font-family",
      "font-size",
      "font-style",
      "font-weight",
      "line-height",
      "text-align",
      "text-decoration",
      "text-overflow",
      "text-transform",
      "white-space",
      "vertical-align",
      "color",
      "overflow",
      "clip",
      "content"
    ],
    "color-no-hex": [true, { "severity": "error" }],
    "color-named": ["never", { "severity": "error" }],
    "function-disallowed-list": [
      ["/^(rgba?|hsla?|hwb|lab|lch|oklab|oklch|color|color-mix|light-dark)$/i"],
      { "severity": "error" }
    ],
    "declaration-property-value-disallowed-list": [
      {
        "/.*/": [
          "/var\\(\\s*--color-(?:[a-z-]+-\\d+|white|black|lavender)(?![\\w-])/i",
          "/\\w\\.color\\(/i",
          "/\\$color-/i",
          "/\\$colors(?![\\w-])/i",
          "/\\$(?:link-color|background-color|body-text-color|title-text-color|field-border(?!-radius)|select-bg|box-shadow-|button-border-color-focus)/i",
          "/var\\(\\s*[^,)]*,\\s*(?!\\s|var\\(|(?:transparent|currentcolor|none|inherit|initial|unset|revert|auto|normal|-?[\\d.]+(?:%|[a-z]+)?)\\s*\\))/i"
        ]
      },
      { "severity": "error" }
    ],
    "selector-disallowed-list": [
      ["/\\[\\s*data-theme/i"],
      { "severity": "error" }
    ]
  },
  "overrides": [
    {
      "files": ["svelte/**/*.svelte"],
      "customSyntax": "postcss-html"
    },
    {
      "files": ["kitsune/sumo/static/sumo/scss/config/**/*.scss"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null,
        "selector-disallowed-list": null
      }
    },
    {
      "files": ["kitsune/sumo/static/sumo/scss/_theme.scss"],
      "rules": {
        "selector-disallowed-list": null
      }
    },
    {
      "files": [
        "kitsune/sumo/static/sumo/scss/_device-migration-wizard.scss",
        "kitsune/sumo/static/sumo/scss/components/_dashboards.scss",
        "kitsune/sumo/static/sumo/scss/form-step.styles.scss",
        "kitsune/sumo/static/sumo/scss/form-wizard-configure-step.styles.scss",
        "kitsune/sumo/static/sumo/scss/form-wizard-setup-device-step.styles.scss",
        "kitsune/sumo/static/sumo/scss/form-wizard.styles.scss",
        "kitsune/sumo/static/sumo/scss/reminder-dialog.styles.scss",
        "svelte/contribute/Contribute.svelte"
      ],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
